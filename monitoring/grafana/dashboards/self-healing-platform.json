                        "index": 0,
                        "text": "DOWN"
                      },
                      "1": {
                        "color": "green",
                        "index": 1,
                        "text": "UP"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      }
